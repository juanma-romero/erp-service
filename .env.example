# Plantilla de configuración del ERP Service.
#   cp .env.example .env   y completar los valores.
# `.env` NO se versiona (.gitignore); este archivo SÍ, así que NUNCA poner secretos reales acá.

# ---------- ERPNext ----------
ERPNEXT_URL=https://vorazadmin.site
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# ---------- Cuentas contables (empresa Voraz) ----------
# El valor debe ser el nombre EXACTO de la Account en el plan de cuentas de ERPNext:
# si no coincide, el cobro falla o se acredita en la cuenta equivocada.
#   ACCOUNT_CASH -> cobros en efectivo        (Mode of Payment: "Cash")
#   ACCOUNT_BANK -> cobros por transferencia  (Mode of Payment: "Wire Transfer")
ACCOUNT_CASH="Efectivo - Vz"
ACCOUNT_BANK=1214 - Familiar - Vz

# ---------- Runtime ----------
PORT=8001
# VENTAS_CACHE_DIR=/app/data/contabilidad

# ---------- Solo para consultas manuales a producción (scripts / curl) ----------
# ERPNEXT_URL_PROD=
# ERPNEXT_API_KEY_PROD=
# ERPNEXT_API_SECRET_PROD=
